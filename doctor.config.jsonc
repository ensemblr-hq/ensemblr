{
	"$schema": "https://react.doctor/schema/config.json",
	"ignore": {
		// Build and scratch output, all gitignored. `--scope full` walks these
		// anyway, so the minified vendor bundles under `.vite/` (mermaid,
		// cytoscape, the php/blade highlighters) report as first-party findings —
		// `insecure-crypto-risk` ×10 came entirely from there. Nothing here is
		// authored: it is regenerated by `npm run build` from `src/`, which the
		// scan already covers.
		//
		// Entry points are declared in `knip.jsonc`, not here — react-doctor's
		// dead-code pass reads them from a knip config. Declare a new entry there
		// rather than ignoring the files it reaches.
		//
		// Every override below suppresses a finding that reproduces today. Before
		// adding one, confirm the rule actually fires: `react-doctor rules list`
		// shows which rules are off by default (`no-multi-comp` and
		// `no-cascading-set-state` are), and an override for a rule that fires
		// nothing is a blind spot for the next regression in that file.
		"files": [".vite/**", "out/**", "dist/**", "coverage/**", ".context/**"],
		"overrides": [
			{
				// shadcn primitives co-locate `cva` variant tables with their
				// component (e.g. `buttonVariants` in button.tsx) — the canonical
				// shadcn shape. That colocated non-component export trips
				// only-export-components; for these vendored single-consumer variant
				// tables the colocation is intended, so suppress the rule here.
				// App code does not get this exemption: a pure helper exported from a
				// component file belongs in `lib/` (see `getNextThinkingId`, moved to
				// `lib/workbench/thinking-strength.ts` rather than suppressed).
				"files": [
					"src/renderer/components/ui/badge.tsx",
					"src/renderer/components/ui/button.tsx",
					"src/renderer/components/ui/textarea.tsx"
				],
				"rules": ["react-doctor/only-export-components"]
			},
			{
				// StackTraceActions uses <fieldset> to group action buttons and stops
				// click/keyboard propagation so they don't toggle the collapsible
				// header. The handlers are pure propagation stoppers, and keyboard
				// users reach each button directly, so the wrapper does not need its
				// own interactive role.
				"files": ["src/renderer/components/stack-trace.tsx"],
				"rules": ["react-doctor/no-noninteractive-element-interactions"]
			},
			{
				// Sequential by intent, each for its own reason. summary-queue drains
				// a `for(;;)` loop that serializes summary writes so an older LLM
				// response cannot win the race. delete-repository runs `git worktree
				// remove` per workspace, which would race on `.git/index.lock`. The
				// Codex rollout walk (agent-conversation-title) recurses newest-first
				// under a MAX_SESSION_CANDIDATES budget with early returns. The
				// pasted-file save loop (composer-attachments) preserves paste order,
				// stops on the first error, and avoids saveCopy filename-collision
				// races. Promise.all would corrupt the index, overshoot the budget, or
				// change error/collision semantics.
				"files": [
					"src/main/agent-runtime/session/summary-queue.ts",
					"src/main/repository/delete-repository.ts",
					"src/main/terminal/agent-conversation-title.ts",
					"src/renderer/lib/workbench/composer-attachments.ts"
				],
				"rules": ["react-doctor/async-await-in-loop"]
			},
			{
				// Two consecutive awaits that the rule reads as independent, but each
				// pair has an ordering constraint the AST cannot see. workspace-teardown
				// stops the agent runtimes before it lists and kills the PTYs, because a
				// live agent can open a terminal through agent control — listing first
				// would miss any PTY started in between, and both phases are already
				// individually deadlined so the ordering costs a bounded wait. In
				// unarchive-workspace the `post-unarchive-workspace` hook must observe
				// the finished workspace: it fires after `.context/` is copied back into
				// the worktree, and racing it would let a subscriber read a half-restored
				// tree. Both pairs also append to one shared `diagnostics` array, so
				// Promise.all would interleave the reported order nondeterministically.
				"files": [
					"src/main/repository/unarchive-workspace.ts",
					"src/main/repository/workspace-teardown.ts"
				],
				"rules": ["react-doctor/server-sequential-independent-await"]
			},
			{
				// `probeContextUsage` guards on `closed` *after* awaiting
				// `getContextUsage()` on purpose: the check asks whether the session
				// shut down while that control request was in flight, so hoisting it
				// above the await — which is what the rule asks for — removes the only
				// state it exists to observe and lets a dead session emit a usage
				// event. The inline why-comment says the same at the call site.
				"files": ["src/main/claude-agent/claude-agent-adapter.ts"],
				"rules": ["react-doctor/async-defer-await"]
			},
			{
				// Main-process modules import their storage/checkpoint/setup/terminal
				// public surface through the concern barrels — the intended
				// entrypoints, required by src/main/AGENTS.md → Public Surfaces, which
				// says to import from a concern entrypoint when you are outside that
				// concern. main.ts and ipc/handlers.ts additionally re-export types
				// from the setup-diagnostics barrel so IPC contracts have one import
				// surface. The no-barrel-import perf rule targets renderer bundle
				// tree-shaking; the Electron main process is not bundled that way, so
				// the cost is moot here.
				"files": [
					"src/main/main.ts",
					"src/main/ipc/handlers.ts",
					"src/main/checkpoints/checkpoint-service.ts",
					"src/main/ipc/handlers/checkpoint.ts",
					"src/main/agent-runtime/agent-session-persistence.ts",
					"src/main/agent-runtime/session/chat-tab-plumbing.ts",
					"src/main/agent-providers/claude-readiness-probe.ts",
					"src/main/agent-providers/pi-readiness-probe.ts",
					"src/main/agent-control/port-adapters.ts"
				],
				"rules": ["react-doctor/no-barrel-import"]
			},
			{
				// Composer insertion uses a dispatcher pattern (queue atom → effect on
				// a consumer hook) intentionally so review surfaces can fire inserts
				// without prop-drilling the composer down to leaf cells. The callback
				// is the Lexical editor's imperative insert, which places the caret
				// and preserves chips — writing the draft atom directly (as
				// `useComposerInsertToChat` does for a non-mounted tab) would clobber
				// the live editor state.
				"files": ["src/renderer/state/composer/composer-insert.ts"],
				"rules": ["react-doctor/no-pass-data-to-parent"]
			},
			{
				// Append-only or render-once lists whose items carry no stable
				// identity: the clone progress log (lines appended in order, never
				// removed) and archive diagnostics (rendered once on failure). Neither
				// reorders or filters, and both already pair the index with a
				// discriminator, so the keys are stable for reconciliation.
				"files": [
					"src/renderer/components/welcome/clone-github-progress-log.tsx",
					"src/renderer/components/workbench-shell/archive-diagnostics-list.tsx"
				],
				"rules": ["react-doctor/no-array-index-as-key"]
			},
			{
				// Bundled `motion` import is intentional. LazyMotion's main win is
				// download bundle size (`m` ~4.6kb vs `motion` ~34kb); this app is
				// Electron-packaged with no over-the-network bundle, so that win is
				// moot. The smaller parse/exec cost still applies but isn't worth the
				// LazyMotion indirection here. The onboarding wizard is the strongest
				// case for the bundled import: it is the very first surface a new
				// install renders, so a LazyMotion feature bundle resolving after
				// first paint would drop the entrance animations it exists to play.
				"files": [
					"src/renderer/components/onboarding/onboarding-step-rail.tsx",
					"src/renderer/components/onboarding/onboarding-welcome.tsx",
					"src/renderer/components/onboarding/onboarding-wizard.tsx"
				],
				"rules": ["react-doctor/use-lazy-motion"]
			},
			{
				// The agent-control MCP server intentionally exposes agent-control tools —
				// that IS the product surface. It is gated behind loopback-only host
				// checks (DNS-rebinding guard) and a per-request bearer token: see
				// control-server.ts, which 401s a missing token and delegates validation
				// to AgentControlService.invoke. The capability is by design and
				// authenticated, not an unguarded sink.
				"files": ["src/main/agent-control/mcp-endpoint.ts"],
				"rules": ["react-doctor/mcp-tool-capability-risk"]
			}
		]
	}
}
