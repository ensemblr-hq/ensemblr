{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

	// Electron Forge + Vite entries. The main/preload/renderer trio is the
	// authoritative entry surface; vite + forge configs feed the bundler.
	"entry": [
		"src/main/main.ts",
		"src/preload/preload.ts",
		"src/renderer/main.tsx",
		"forge.config.ts",
		// Read by the `i18n:*` npm scripts (i18next-cli), not imported by src.
		"i18next.config.ts",
		"vite.main.config.mts",
		"vite.preload.config.mts",
		"vite.renderer.config.mts",
		// Dev-only preview harness, served by `npm run dev:playground`. The config
		// reaches playground/index.html through a `/playground/` redirect string,
		// which is not a resolvable import edge, so the module the page loads is
		// named directly the same way src/renderer/main.tsx is above.
		"vite.playground.config.mts",
		"playground/main.tsx",
		// Demo mode's two Vite configs. `scripts/run-demo.mjs` reaches each by
		// path string rather than by import, so neither is a resolvable edge —
		// name them the way the playground config above is named. The tree they
		// build is ignored outright; see `demo/**` in ignorePatterns.
		"vite.demo.config.mts",
		"vite.demo-main.config.mts",
		// Vitest runs renderer tests directly; treat each file as an entry so
		// fallow doesn't flag them as unused.
		"tests/**/*.test.{ts,tsx}",
		// Dev tooling scripts run directly via `node` (.mjs) or `npx tsx` (.ts);
		// treat each as an entry so fallow doesn't flag them as unused files.
		"scripts/**/*.{mjs,ts}",
		// Pi extensions are loaded at runtime by the Pi child via
		// `pi --mode rpc -e <file>`; nothing imports them statically.
		"resources/pi-extensions/*.mts",
		// Concern barrels are the mandated public entrypoints (src/shared
		// AGENTS.md: "keep the root file as the public entrypoint"; renderer
		// AGENTS.md: state via `state/<concern>/index.ts`, and `lib/<concern>/index.ts`
		// runtime-value barrels). Their re-export surface is intentional public
		// API consumed across process boundaries, not dead code — encode that here
		// rather than leaving ~360 acknowledged "not a bug" barrel warnings.
		"src/shared/ipc/index.ts",
		"src/shared/pi-rpc/index.ts",
		"src/shared/keymap/index.ts",
		// Root-file form of the same rule, for the multi-file concerns that
		// aggregate their `<concern>/` implementation dir behind `<concern>.ts`.
		// That form is the one `src/shared/AGENTS.md` names first and the one the
		// Node ESM loader can resolve from `electron --test` (a bare directory
		// specifier cannot be). Single-file concerns are NOT listed here: they
		// are plain modules reached through normal imports, so a real unused
		// export in one should still surface.
		"src/shared/agent-failure.ts",
		"src/shared/architecture-diagram.ts",
		"src/shared/plan-mode.ts",
		"src/shared/scripts.ts",
		"src/shared/terminal.ts",
		"src/renderer/state/*/index.ts",
		"src/renderer/lib/*/index.ts",
		"src/renderer/types/*/index.ts",
		"src/renderer/components/**/index.ts"
	],

	"ignorePatterns": [
		// Build / cache output
		".vite/**",
		"out/**",
		".fallow/**",
		".demo/**",
		// Demo mode is a screenshot harness, not part of the product: a separate
		// Electron entrypoint that renders the shipped renderer against scripted
		// fixtures, launched by `npm run dev:demo` rather than by Forge. Nothing
		// under src/ imports it and the packaged app carries none of it, which
		// `tests/renderer/demo-isolation.test.ts` enforces in both directions.
		// Analysing it as first-party is therefore all noise: a scenario is a
		// fixture whose only consumer is the scenario registry, and its shape is
		// dictated by the bridge calls a route happens to make rather than by
		// anything fallow can reason about. See ADR 0058.
		"demo/**"
		// NOTE: vendored shadcn `ui/**` is intentionally NOT ignored here. A
		// primitive that was installed but has no consumers should surface as an
		// unused file. Per-rule style noise on the used primitives (unused
		// exports, etc.) is quieted below via `ignoreExports`, not by hiding the
		// whole tree.
	],

	// Vendored shadcn `ui/**` (ignored above) is the sole consumer of these
	// hooks/atoms, so fallow can't see those import edges. Treat the consumed
	// files as dynamically loaded so fallow stops marking them dead.
	"dynamicallyLoaded": [
		"src/renderer/hooks/use-mobile.ts",
		"src/renderer/hooks/use-raised-shadow.ts",
		"src/renderer/state/sidebar/index.ts"
	],

	// Tests import the shared/ipc barrel via the implicit `index` resolution
	// that tsconfig `bundler` moduleResolution handles. Fallow's resolver
	// doesn't honor that for explicit `.ts` extensions, so silence the noise.
	"ignoreUnresolvedImports": ["../../src/shared/ipc.ts"],

	// electron-forge consumes this as a peer dep transitively via the maker
	// plugins; the type-only import in forge.config.ts is legitimate.
	// cva / cmdk / radix-ui are imported only from the vendored shadcn/ui
	// surface in src/renderer/components/ui (ignored above), so fallow
	// can't see those edges; allowlist them explicitly.
	// tailwindcss / @tailwindcss/typography / shadcn are pulled in via CSS build
	// directives (`@import "tailwindcss"`, `@plugin "@tailwindcss/typography"`,
	// `@import "shadcn/tailwind.css"`) in src/renderer/styles/index.css. Fallow
	// reads those as production imports and wants them moved to `dependencies`,
	// but they are build-time only — Vite/PostCSS compiles the CSS at build, so
	// devDependencies is correct and the renderer bundle needs none at runtime.
	// i18next-cli is invoked only through the `i18n:*` npm scripts, so there is
	// no import edge for fallow to follow.
	// node-abi is required at build time by scripts/require-linux-toolchain.mjs,
	// which resolves the ABI @electron/rebuild stamps into node-pty's
	// `.forge-meta` so the guard can tell an Electron-built binding from a
	// Node-built one. Fallow reads `scripts/**` as production and wants it in
	// `dependencies`, but nothing under `scripts/` is packaged — it runs from the
	// repo checkout, before `electron-forge` does.
	"ignoreDependencies": [
		"@electron-forge/shared-types",
		"node-abi",
		"@tailwindcss/typography",
		"i18next-cli",
		"class-variance-authority",
		"cmdk",
		"radix-ui",
		"shadcn",
		"tailwindcss"
	],

	// shadcn/ui registry components are vendored verbatim; the unused
	// surface is intentional API completeness for future composition.
	// Domain constants below are deliberately public for future callers
	// even though current consumption lives in their declaring file.
	"ignoreExports": [
		{ "file": "src/renderer/components/ui/**/*.tsx", "exports": ["*"] },
		// TanStack Router generates routeTree.gen.ts; its route types are consumed
		// via module augmentation, not direct imports, and it is never hand-edited.
		// Ignored per-export (not via ignorePatterns) to keep its edges to the
		// route files intact for dead-code analysis.
		{ "file": "src/renderer/routing/routeTree.gen.ts", "exports": ["*"] },
		{ "file": "src/shared/permissions.ts", "exports": ["PERMISSION_MODES"] },
		{
			"file": "src/renderer/state/recents/atoms.ts",
			"exports": [
				"RECENT_PROJECTS_STORAGE_KEY",
				"RECENT_PROJECTS_STORAGE_VERSION"
			]
		}
	],

	"duplicates": {
		// Pair-only clones are too noisy in a 350-file Electron app.
		"minOccurrences": 2,
		"minTokens": 60,
		"ignore": ["src/renderer/routing/routeTree.gen.ts", "tests/**"]
	},

	"health": {
		"maxCognitive": 20,
		"maxCyclomatic": 25,
		// CRAP is `cyclomatic² × (1 − coverage)³ + cyclomatic`, so without real
		// coverage fallow estimates the coverage term from export references and
		// the cubed factor dominates — an 11-line function with cyclomatic 5 lands
		// on the complexity list purely for looking untested. Point at the Istanbul
		// report `npx vitest run --coverage` writes so the scores are measured
		// instead. Absent (a fresh clone that has not run coverage yet) fallow
		// falls back to the estimate and still exits 0, so this is safe to commit.
		"coverage": "coverage/coverage-final.json",

		"thresholdOverrides": [
			{
				"files": ["playground/**"],
				"maxCrap": 60,
				"reason": "Dev-only preview harness. Vitest never runs playground/, so its coverage term is structurally 0 and CRAP collapses to cyclomatic² + cyclomatic — a 12-line fixture that defaults seven fields lands at 56 purely for being untested by design. Cyclomatic and cognitive ceilings still apply unchanged, so a genuinely convoluted scene is still reported."
			},
			{
				"files": ["src/main/**"],
				"maxCrap": 650,
				"reason": "Most of tests/main runs on `electron --test`, which emits no Istanbul data (see the vitest.config.mts prologue — only the pure-logic node-env suites are wired into Vitest). A well-tested main-process module therefore reports coverage 0 and CRAP collapses to cyclomatic² + cyclomatic, so a 5-branch check lands at 30 purely for being tested by the other runner. 650 is cyclomatic² + cyclomatic at the maxCyclomatic ceiling of 25, which makes cyclomatic and cognitive the real gates for this tree instead of a coverage term that cannot be measured. Revisit if the electron suites ever emit coverage."
			}
		]
	},

	"rules": {
		// shadcn/ui dumps full primitive surfaces; demote to warn so the
		// signal/noise ratio for real dead code stays high.
		"unused-exports": "warn",
		"unused-types": "warn",
		// Barrel re-exports across feature folders are an architectural
		// choice here, not a bug.
		"re-export-cycle": "off"
	}
}
