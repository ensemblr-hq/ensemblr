{
	"name": "ensemblr",
	"productName": "Ensemblr",
	"version": "0.1.2",
	"description": "A desktop workbench for isolated, multi-agent coding workflows.",
	"homepage": "https://www.ensemblr.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ensemblr-hq/ensemblr.git"
	},
	"bugs": {
		"url": "https://github.com/ensemblr-hq/ensemblr/issues"
	},
	"main": ".vite/build/main.js",
	"private": true,
	"packageManager": "npm@11.17.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"preinstall": "node scripts/require-node-version.mjs --stage=install",
		"dev": "node scripts/require-node-version.mjs --stage=dev && node scripts/require-linux-toolchain.mjs && electron-forge start",
		"dev:playground": "vite --config vite.playground.config.mts",
		"start": "npm run dev",
		"check": "biome check . && npm run check:tailwind && npm run check:strings && npm run i18n:lint",
		"check:strings": "node scripts/check-hardcoded-strings.mjs",
		"credits:generate": "node scripts/generate-credits.mjs && biome check --write src/main/menu/credits-manifest.gen.ts",
		"check:tailwind": "node scripts/check-tailwind-classes.mjs",
		"check:fix": "biome check --write .",
		"i18n:extract": "i18next-cli extract && biome check --write src/renderer/lib/i18n/locales",
		"i18n:types": "i18next-cli types && biome check --write src/renderer/types/resources.d.ts src/renderer/types/i18next.d.ts",
		"i18n:status": "i18next-cli status",
		"i18n:lint": "i18next-cli lint",
		"icon:generate": "node scripts/generate-app-icon.mjs",
		"avatar:generate": "node scripts/generate-avatar.mjs",
		"wordmark:generate": "node scripts/generate-wordmark-gif.mjs",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"test:commands": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/local-command.test.ts",
		"test:config": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/config-loader.test.ts tests/main/config-resolution.test.ts tests/main/repository-config.test.ts tests/main/repository-scripts-writer.test.ts tests/main/repository-scripts-migration.test.ts tests/main/repository-settings.test.ts tests/main/repository-config-file.test.ts tests/main/permissions.test.ts",
		"test:checkpoints": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/checkpoint-capture.test.ts tests/main/checkpoint-restore.test.ts",
		"test:db": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/database.test.ts",
		"test:concierge": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/concierge-storage.test.ts",
		"test:agent-storage": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/agent-session-repository.test.ts tests/main/agent-event-repository.test.ts tests/main/chat-tab-repository.test.ts tests/main/chat-tab-service.test.ts tests/main/closed-tab-summary.test.ts tests/main/chat-tab-preview-slot.test.ts tests/main/chat-tab-plumbing.test.ts",
		"test:environment": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/environment-variables.test.ts",
		"test:workspace-environment": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/workspace-environment.test.ts",
		"test:terminal": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/terminal-service.test.ts tests/main/terminal-output-file.test.ts tests/main/persist-terminal-agent-session.test.ts",
		"test:open-targets": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/open-target-registry.test.ts tests/main/detect-installed-targets.test.ts",
		"test:scripts": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/script-lifecycle.test.ts",
		"test:app": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/main-window-state.test.ts",
		"test:pi": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/pi-executable.test.ts tests/main/pi-readiness.test.ts",
		"test:agent-runtime": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/agent-client.test.ts tests/main/jsonl-line-stream.test.ts tests/main/pi-cli-rpc-adapter.test.ts tests/main/claude-agent-normalizer.test.ts",
		"test:agent-session": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/agent-session-service.test.ts",
		"test:pi-rpc": "vitest run tests/shared/pi-rpc-parse.test.ts",
		"test:keymap": "vitest run tests/shared/keymap-matcher.test.ts",
		"test:app-settings": "vitest run tests/shared/app-settings.test.ts tests/main/app-settings-service.test.ts",
		"test:branch-name": "vitest run tests/main/branch-name-slug.test.ts",
		"test:schemas": "vitest run tests/main/request-schemas.test.ts",
		"test:validate-git-ref": "vitest run tests/main/validate-git-ref.test.ts",
		"test:composer-seed": "vitest run tests/renderer/linked-issue-composer-seed.test.ts",
		"test:source-mappers": "vitest run tests/renderer/workspace-source-mappers.test.ts",
		"test:external-links": "vitest run tests/main/external-links-policy.test.ts",
		"test:format-duration": "vitest run tests/renderer/format-duration.test.ts",
		"test:pi-replay": "vitest run tests/renderer/pi-replay-reducer.test.ts",
		"test:groups": "vitest run tests/renderer/model-picker-groups.test.ts",
		"test:model-names": "vitest run tests/renderer/model-display-name.test.ts",
		"test:terminal-tabs": "vitest run tests/renderer/terminal-tabs.test.ts",
		"test:session-tab-close": "vitest run tests/renderer/session-tab-close.test.ts",
		"test:close-guard": "vitest run tests/renderer/close-running-chat-guard.test.ts",
		"test:github-repo-search": "vitest run tests/renderer/github-repo-search.test.ts",
		"test:renderer": "vitest run tests/renderer",
		"test:renderer-dom": "vitest run tests/renderer/dom",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:repository": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/register-repository.test.ts tests/main/import-local-repository.test.ts tests/main/clone-repository.test.ts tests/main/list-github-owners.test.ts tests/main/list-github-repositories.test.ts tests/main/list-github-remote-branches.test.ts tests/main/quick-start-project.test.ts",
		"test:workspace": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/create-workspace.test.ts",
		"test:workspace-rename": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/rename-workspace.test.ts",
		"test:worktree-add": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/git-ops-worktree-add.test.ts tests/main/git-ops-worktree-remove.test.ts",
		"test:workspace-base-branch": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/set-workspace-base-branch.test.ts",
		"test:continue-branch": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/continue-workspace-branch.test.ts",
		"test:ensure-base-ref": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/ensure-base-ref.test.ts",
		"test:repository-sources": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/repository-sources.test.ts",
		"test:workspace-git": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/workspace-git-status.test.ts",
		"test:github": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/github-service.test.ts tests/main/review-comments.test.ts tests/main/pr-snapshot.test.ts",
		"test:review-model": "vitest run tests/renderer/pull-request-model.test.ts",
		"test:archive": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/archive-lifecycle.test.ts tests/main/archive-workspace.test.ts tests/main/delete-workspace.test.ts tests/main/delete-repository.test.ts tests/main/browse-archive.test.ts tests/main/prune-worktree.test.ts tests/main/rehydrate-worktree.test.ts",
		"test:history": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/list-all-workspaces.test.ts",
		"test:root": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/root-directory.test.ts tests/main/adopt-shared-root.test.ts",
		"test:secrets": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/secret-store.test.ts",
		"test:setup": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/setup-diagnostics.test.ts tests/main/setup-state-file.test.ts",
		"test:linear": "ELECTRON_RUN_AS_NODE=1 electron --test tests/main/linear-oauth.test.ts tests/main/linear-oauth-callback-server.test.ts tests/main/linear-auth-service.test.ts tests/main/linear-client.test.ts tests/main/linear-store.test.ts tests/main/linear-service.test.ts tests/main/workspace-create-linked-issue.test.ts",
		"test:linear-renderer": "vitest run tests/renderer/linear-issue-view.test.ts tests/renderer/linear-issue-editor.test.ts tests/renderer/workspace-linked-issue-landing.test.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.tests.json",
		"build": "node scripts/require-node-version.mjs && electron-forge package --arch=arm64",
		"package": "node scripts/require-node-version.mjs && electron-forge package --arch=arm64",
		"make": "node scripts/require-node-version.mjs && electron-forge make --arch=arm64",
		"make:canary": "ENSEMBLR_BUILD_CHANNEL=canary npm run make",
		"make:dev": "ENSEMBLR_BUILD_CHANNEL=dev npm run make",
		"make:unsigned": "ENSEMBLR_SKIP_SIGN=1 npm run make",
		"make:linux": "node scripts/require-node-version.mjs && node scripts/require-linux-host.mjs && node scripts/require-linux-toolchain.mjs && electron-forge make --platform=linux --arch=x64",
		"package:linux": "node scripts/require-node-version.mjs && node scripts/require-linux-host.mjs && node scripts/require-linux-toolchain.mjs && electron-forge package --platform=linux --arch=x64",
		"rebuild:native": "./scripts/rebuild-native-linux.sh",
		"package:dev": "ENSEMBLR_BUILD_CHANNEL=dev npm run package",
		"package:unsigned": "ENSEMBLR_SKIP_SIGN=1 npm run package",
		"verify:signing": "node scripts/verify-signed-artifacts.mjs",
		"diagnose:dock-flash": "node scripts/diagnose-dock-flash.mjs",
		"diagnose:linux": "node scripts/require-linux-toolchain.mjs --report",
		"doctor": "npx react-doctor@latest",
		"postinstall": "node scripts/fix-node-pty-permissions.mjs"
	},
	"keywords": [
		"electron",
		"ensemblr",
		"linux",
		"macos",
		"pi"
	],
	"author": {
		"name": "Philipp Soldunov",
		"email": "69530789+psoldunov@users.noreply.github.com"
	},
	"license": "Apache-2.0",
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.259",
		"@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.0",
		"@iconify-json/logos": "^1.2.13",
		"@iconify-json/vscode-icons": "^1.2.76",
		"@iconify/react": "^6.0.2",
		"@lexical/react": "^0.49.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@radix-ui/react-use-controllable-state": "^1.2.3",
		"@streamdown/cjk": "^1.0.3",
		"@streamdown/code": "^1.1.1",
		"@streamdown/math": "^1.0.2",
		"@streamdown/mermaid": "^1.0.2",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-virtual": "^3.14.10",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"ai": "^7.0.91",
		"ansi-to-react": "^6.2.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"i18next": "^26.4.1",
		"jotai": "^2.20.3",
		"jotai-family": "^1.1.0",
		"js-toml": "^2.0.1",
		"lexical": "^0.49.0",
		"lucide-react": "^1.40.0",
		"motion": "^13.2.0",
		"node-pty": "^1.1.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.7",
		"react-day-picker": "^10.0.1",
		"react-diff-view": "^3.3.3",
		"react-dom": "^19.2.7",
		"react-i18next": "^17.0.13",
		"react-resizable-panels": "^4.12.3",
		"semver": "^7.8.5",
		"shiki": "^4.4.3",
		"sonner": "^2.0.8",
		"streamdown": "^2.6.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"use-stick-to-bottom": "^1.1.6",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-dmg": "^7.11.2",
		"@electron-forge/maker-zip": "^7.11.2",
		"@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
		"@electron-forge/plugin-fuses": "^7.11.2",
		"@electron-forge/plugin-vite": "^7.11.2",
		"@electron/fuses": "^2.1.3",
		"@reforged/maker-appimage": "^5.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1.168.35",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@types/semver": "^7.8.0",
		"@vitejs/plugin-react": "6.1.0",
		"@vitest/coverage-istanbul": "^4.1.11",
		"dotenv": "^17.4.2",
		"electron": "^44.1.1",
		"happy-dom": "^20.11.10",
		"i18next-cli": "^1.72.4",
		"node-abi": "^4.35.0",
		"shadcn": "^4.20.1",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"@electron/node-gyp": "10.2.0-electron.1",
		"extract-zip": "npm:@electron-internal/extract-zip@^1.0.5",
		"linkify-it": "^5.0.2",
		"shiki": "$shiki",
		"tar": "^7.5.19",
		"tmp": "^0.2.7"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fs-xattr@0.3.1": true,
		"macos-alias@0.2.12": true,
		"@swc/core": false,
		"core-js-pure": false,
		"node-pty": false
	}
}
