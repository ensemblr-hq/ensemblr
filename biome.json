{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"maxSize": 400000,
		"includes": [
			"**",
			"!.agents/skills/ai-elements/scripts",
			"!.claude",
			"!.ensemblr/architecture.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noArrayIndexKey": "off"
			},
			"complexity": {
				"noUselessFragments": "info"
			},
			"a11y": {
				"noStaticElementInteractions": "info"
			},
			"nursery": {
				"useTailwindSortedClasses": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "single"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		},
		"linter": {
			"enabled": false
		}
	},
	"tailwind": {
		"attributes": ["class", "className", "classList"],
		"mergeFunctions": ["cn", "clsx", "tw"]
	}
}
