{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": [
			"**",
			"!.demo",
			"!src/components/ui",
			"!src/hooks/ui",
			"!src/renderer/fixtures/pi-captures",
			"!tests/fixtures/architecture",
			"!src/renderer/routing/routeTree.gen.ts"
		]
	},
	"overrides": [
		{
			"includes": ["src/renderer/components/ui/**", "tests/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		}
	]
}
